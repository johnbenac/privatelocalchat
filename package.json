{
  "name": "privatelocalchat",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "e2e": "node scripts/e2e.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "snapshot:check": "node scripts/snapshot.mjs diff docs/evidence/split/runkit-baseline.json",
