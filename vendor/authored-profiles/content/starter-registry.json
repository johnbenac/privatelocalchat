          },
          "premise": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kindOfBeing": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "commitments": {
            "type": "array",
