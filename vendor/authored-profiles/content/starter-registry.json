          "path": "/repertoire/*/reference",
          "collection": "references"
        }
      ]
    },
    {
      "id": "core:look",
      "version": "0",
      "label": "Look development",
      "definition": "Visual brief, commitments, studies and revisions in an explicit context.",
      "schema": {
        "type": "object",
        "properties": {
          "brief": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "commitments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "freedoms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "studies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            "uniqueItems": true
          },
          "portrayals": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            "uniqueItems": true
          },
          "revisions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "change": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "preserved": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "before": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._/-]*$"
                },
                "after": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._/-]*$"
                },
                "decision": {
                  "enum": [
                    "keep",
                    "undo",
                    "revise"
                  ]
                }
              },
              "required": [
                "change",
                "preserved"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "scopes": [
        "subject",
        "context",
        "instance"
      ],
      "links": [
        {
          "path": "/studies/*",
          "collection": "expressions"
        },
        {
          "path": "/portrayals/*",
          "collection": "expressions"
        },
        {
          "path": "/revisions/*/before",
          "collection": "expressions"
        },
        {
          "path": "/revisions/*/after",
          "collection": "expressions"
        }
      ]
    },
