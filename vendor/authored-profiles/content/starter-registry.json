    {
      "id": "core:voice",
      "version": "0",
      "label": "Voice identity",
      "definition": "Speaker description and selected references, separate from a delivery.",
      "schema": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "timbre": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
